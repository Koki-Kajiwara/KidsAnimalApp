<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsAnimalApp.Views.CmnParts_AnimalCentralPlacement_View">
    <!-- TODO: 背景を透明度のあるBlackにしたい -->
    <Grid>
        <!-- TODO: アイコンサイズの調整 -->
        <Image Source="{Binding AnimalImagePath}" 
               WidthRequest="150"
               HeightRequest="150"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <!-- TODO: 文字サイズ、フォントの調整 -->
        <Label Text="{Binding AnimalName}" 
               HorizontalOptions="Center"
               VerticalOptions="End"
               FontSize="24"
               TextColor="Black" />
    </Grid>
</ContentView>
