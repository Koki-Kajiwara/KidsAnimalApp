<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KidsAnimalApp.Views.CmnParts_AnimalCentralPlacement_View">
    
    <Grid HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
        <Image Source="{Binding SelectedAnimalImagePath}" 
               WidthRequest="400"
               HeightRequest="400"
               HorizontalOptions="Center"
               VerticalOptions="Center" />
        <!-- TODO: 文字サイズ、フォントの調整 -->
        <Label Text="{Binding SelectedAnimalName}" 
               HorizontalOptions="Center"
               VerticalOptions="End"
               FontSize="50"
               TextColor="white" />
    </Grid>
</ContentView>
